generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EV {
  id              Int      @id @default(autoincrement())
  name            String
  region          String
  country         String   @default("Argentina")
  status          String   @default("Activa")
  leaderName      String?
  leaderRole      String?
  electionDate    DateTime?
  totalVolunteers Int      @default(0)
  idoneidad       Boolean  @default(false)
  planAnual       Boolean  @default(false)
  visitaPlanif    Boolean  @default(false)
  visitaRealizada Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hosting      Hosting[]
  sending      Sending[]
  ewa          EWA[]
  coordinators Coordinator[]
  teamMembers  TeamMember[]
  notes        EVNote[]
  tags         EVTagOnEV[]
}

model Hosting {
  id         Int      @id @default(autoincrement())
  evId       Int
  ev         EV       @relation(fields: [evId], references: [id], onDelete: Cascade)
  year       Int
  totalQuota Int      @default(0)
  shQuota    Int      @default(0)
  nhQuota    Int      @default(0)
  shStatus   String   @default("Pendiente")
  nhStatus   String   @default("Pendiente")
  notes      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Sending {
  id        Int      @id @default(autoincrement())
  evId      Int
  ev        EV       @relation(fields: [evId], references: [id], onDelete: Cascade)
  cycle     String
  students  Int      @default(0)
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EWA {
  id          Int      @id @default(autoincrement())
  evId        Int
  ev          EV       @relation(fields: [evId], references: [id], onDelete: Cascade)
  year        Int
  score       Float?
  sending     Float?
  preparation Float?
  hosting     Float?
  devVolunt   Float?
  leadership  Float?
  communityEd Float?
  finances    Float?
  marketing   Float?
  rrii        Float?
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([evId, year])
}

model Coordinator {
  id          Int          @id @default(autoincrement())
  evId        Int
  ev          EV           @relation(fields: [evId], references: [id], onDelete: Cascade)
  area        String
  name        String
  email       String?
  phone       String?
  since       DateTime?
  teamMembers TeamMember[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([evId, area])
}

model TeamMember {
  id            Int          @id @default(autoincrement())
  evId          Int
  ev            EV           @relation(fields: [evId], references: [id], onDelete: Cascade)
  coordinatorId Int?
  coordinator   Coordinator? @relation(fields: [coordinatorId], references: [id], onDelete: SetNull)
  name          String
  role          String?
  email         String?
  phone         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model EVNote {
  id        Int      @id @default(autoincrement())
  evId      Int
  ev        EV       @relation(fields: [evId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EVTag {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  color     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  evs       EVTagOnEV[]
}

model EVTagOnEV {
  evId  Int
  tagId Int
  ev    EV    @relation(fields: [evId], references: [id], onDelete: Cascade)
  tag   EVTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([evId, tagId])
}

model AppSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  group     String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CatalogItem {
  id        Int      @id @default(autoincrement())
  type      String
  key       String
  label     String
  color     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, key])
}
